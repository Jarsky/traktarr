# Copy to .env and edit; docker compose reads it automatically.
# API keys, Radarr/Sonarr addresses and filters go in config/config.json, not here.

# Your time zone (e.g. Europe/London, America/New_York). Log times and "this year" in the filters follow it.
TZ=Etc/UTC

# Colour in `docker logs` (1) or plain text (0).
TRAKTARR_COLOR=1

# Where config.json, cache.db and traktarr.log are kept.
CONFIG_DIR=./config

# Only if you uncomment the networks section in docker-compose.yml: the Docker network Radarr and Sonarr are on.
DOCKER_NETWORK=media
